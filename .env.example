# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRESQL)
# ==============================================================================
# Nome do banco de dados que será criado automaticamente
POSTGRES_DB=nome_do_seu_banco

# Usuário administrador do banco de dados
POSTGRES_USER=seu_usuario

# Senha do usuário administrador (use uma senha forte no arquivo .env real)
POSTGRES_PASSWORD=sua_senha_secreta

# Porta que será exposta na sua máquina local (Padrão: 5432)
POSTGRES_PORT=5432

# ==============================================================================
# CONFIGURAÇÕES DA API (FASTAPI)
# ==============================================================================
# Porta que o FastAPI vai rodar na sua máquina local (Padrão: 8000)
API_PORT=8000

# Ambiente do projeto (development, production, testing)
ENVIRONMENT=development